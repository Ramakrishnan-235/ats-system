FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY requirements-ai.lock ./
RUN pip install --no-cache-dir -r requirements-ai.lock --extra-index-url https://download.pytorch.org/whl/cpu
COPY src ./src
RUN pip install --no-cache-dir --no-deps .
COPY ai_main.py ./
RUN useradd --system --create-home --uid 10001 ats && mkdir -p /models && chown ats:ats /models
ENV HF_HOME=/models
USER ats
EXPOSE 8100
CMD ["uvicorn", "ai_main:app", "--host", "0.0.0.0", "--port", "8100"]
