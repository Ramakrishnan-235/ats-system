# =====================================================================


# LLM Provider Configuration (OpenRouter or Ollama)
# =====================================================================
# Place your OpenRouter API Key below:
OPENROUTER_API_KEY=""

# OpenRouter Endpoint & Model Settings
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="nvidia/nemotron-3.5-lightning:free"
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Local Ollama Fallback Settings (active if OPENROUTER_API_KEY is blank)
OLLAMA_BASE_URL='http://localhost:11435/v1'
OLLAMA_MODEL="gemma4:e2b"

# Optional OpenRouter identification headers
OPENROUTER_HTTP_REFERER="http://localhost:3000"
OPENROUTER_APP_TITLE="AI-Powered ATS"

# =====================================================================
# Database Configuration (PostgreSQL with pgvector)
# =====================================================================
DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@localhost:5433/<db_name>"
SYNC_DATABASE_URL="postgresql://<db_user>:<db_password>@localhost:5433/<db_name>"

# =====================================================================
# Security & API Authentication
# =====================================================================
ATS_AUTH_ENABLED="true"  # Use "false" only for explicit local development
ATS_API_KEY=""  # Required when authentication is enabled; generate a unique secret
ATS_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ATS_MAX_UPLOAD_BYTES="10485760"  # 10 MiB PDF limit

ATS_EMBEDDING_BACKEND="http"

ATS_EMBEDDING_MODEL="google/embeddinggemma-2"

ATS_EMBEDDING_DEVICE="cpu"

ATS_EMBEDDING_BATCH_SIZE="16"

ATS_EMBEDDING_BASE_URL="http://localhost:8001"

# =====================================================================
# LangSmith Observability & Model Performance Tracking
# =====================================================================
# Set to "true" to automatically stream traces, latencies & tokens to LangSmith
LANGCHAIN_TRACING_V2="true"
# Your LangSmith API Key from https://smith.langchain.com (Settings -> API Keys)
LANGCHAIN_API_KEY=""
# Target project to organize candidate evaluations and model benchmarks
LANGCHAIN_PROJECT="ats-candidate-evaluator"
# LangSmith API endpoint (defaults to https://api.smith.langchain.com)
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

