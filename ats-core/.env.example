# Environment Configuration Template
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="deepseek-v4-flash:cloud"

# Database Configuration (Replace with your secure database credentials)
DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@localhost:5433/<db_name>"
SYNC_DATABASE_URL="postgresql://<db_user>:<db_password>@localhost:5433/<db_name>"

# Security & API Authentication
ATS_AUTH_ENABLED="false"  # Set to "true" in production to enforce API Key verification
ATS_API_KEY="your-secure-api-key-here"
