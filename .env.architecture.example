# Copy to .env.architecture and generate unique values. Do not commit credentials.
ATS_DATABASE_PASSWORD=
ATS_RUNTIME_DATABASE_PASSWORD=
ATS_SERVICE_KEY=
ATS_STORAGE_ACCESS_KEY=
ATS_STORAGE_SECRET_KEY=
# Local HTTP development only. Production requires HTTPS and true.
ATS_SECURE_COOKIE=false
ATS_ALLOW_SIGNUP=true
ATS_DEVELOPMENT_MODE=false
ATS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ATS_AI_ENABLE_LLM=true
ATS_AI_ENABLE_EMBEDDINGS=true
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma4:e2b
