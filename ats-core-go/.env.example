# ATS Core Backend (Go Edition) Configuration
PORT=8000
HOST=0.0.0.0
ATS_AUTH_ENABLED=true
ATS_API_KEY=
ATS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ATS_UPLOAD_DIR=./uploads
ATS_MAX_UPLOAD_BYTES=10485760

# AI LLM Provider Configuration
ATS_LLM_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Local Ollama Fallback
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e2b

# PostgreSQL Database (Optional for persistent vector store)
DATABASE_URL=postgresql://ats_user:ats_password@localhost:5433/ats_db
